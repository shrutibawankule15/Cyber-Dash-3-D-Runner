import sys
import random
import pygame

# 1. Initialize Pygame
pygame.init()

# 2. Game Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 400
FPS = 60

# Colors
WHITE = (245, 247, 250)
BLACK = (30, 30, 30)
BLUE = (52, 152, 219)
RED = (231, 76, 60)
GREEN = (46, 204, 113)

# Physics & Player Properties
PLAYER_WIDTH = 40
PLAYER_HEIGHT = 50
PLAYER_START_X = 80
GROUND_Y = SCREEN_HEIGHT - 30

JUMP_STRENGTH = -14
GRAVITY = 0.7

# 3. Setup Screen & Clock
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Endless Runner - VS Code Playable")
clock = pygame.time.Clock()
font = pygame.font.SysFont("Helvetica", 28, bold=True)
large_font = pygame.font.SysFont("Helvetica", 48, bold=True)


# 4. Player Class
class Player(pygame.sprite.Sprite):

  def __init__(self):
    super().__init__()
    self.image = pygame.Surface((PLAYER_WIDTH, PLAYER_HEIGHT))
    self.image.fill(BLUE)
    self.rect = self.image.get_rect(bottomleft=(PLAYER_START_X, GROUND_Y))
    self.vel_y = 0
    self.on_ground = True

  def update(self):
    # Apply Gravity
    self.vel_y += GRAVITY
    self.rect.y += self.vel_y

    # Ground Collision
    if self.rect.bottom >= GROUND_Y:
      self.rect.bottom = GROUND_Y
      self.vel_y = 0
      self.on_ground = True

  def jump(self):
    if self.on_ground:
      self.vel_y = JUMP_STRENGTH
      self.on_ground = False

  def reset(self):
    self.rect.bottomleft = (PLAYER_START_X, GROUND_Y)
    self.vel_y = 0
    self.on_ground = True


# 5. Obstacle Class
class Obstacle(pygame.sprite.Sprite):

  def __init__(self, speed):
    super().__init__()
    width = random.randint(25, 40)
    height = random.randint(35, 65)
    self.image = pygame.Surface((width, height))
    self.image.fill(RED)
    self.rect = self.image.get_rect(bottomleft=(SCREEN_WIDTH + 20, GROUND_Y))
    self.speed = speed

  def update(self):
    self.rect.x -= self.speed
    if self.rect.right < 0:
      self.kill()


# 6. Main Game Function
def main():
  player = Player()
  player_group = pygame.sprite.GroupSingle(player)
  obstacle_group = pygame.sprite.Group()

  # Custom event to spawn obstacles periodically
  SPAWN_OBSTACLE = pygame.USEREVENT + 1
  pygame.time.set_timer(SPAWN_OBSTACLE, 1500)

  game_active = True
  score = 0
  obstacle_speed = 6

  while True:
    for event in pygame.event.get():
      if event.type == pygame.QUIT:
        pygame.quit()
        sys.exit()

      if event.type == pygame.KEYDOWN:
        if event.key == pygame.K_SPACE or event.key == pygame.K_UP:
          if game_active:
            player.jump()
          else:
            # Restart game when pressing Space after Game Over
            game_active = True
            obstacle_group.empty()
            player.reset()
            score = 0
            obstacle_speed = 6
            pygame.time.set_timer(SPAWN_OBSTACLE, 1500)

      if game_active and event.type == SPAWN_OBSTACLE:
        obstacle_group.add(Obstacle(obstacle_speed))

    screen.fill(WHITE)

    if game_active:
      # Increase speed gradually as score rises
      score += 1
      if score % 300 == 0:
        obstacle_speed += 0.5

      # Update Game Elements
      player_group.update()
      obstacle_group.update()

      # Check Collisions
      if pygame.sprite.spritecollide(player, obstacle_group, False):
        game_active = False

      # Drawing
      pygame.draw.rect(
          screen,
          GREEN,
          (0, GROUND_Y, SCREEN_WIDTH, SCREEN_HEIGHT - GROUND_Y),
      )
      player_group.draw(screen)
      obstacle_group.draw(screen)

      # Render Score
      score_surf = font.render(f"Score: {score // 5}", True, BLACK)
      screen.blit(score_surf, (20, 20))

    else:
      # Game Over Screen
      screen.fill(BLACK)
      over_surf = large_font.render("GAME OVER", True, RED)
      over_rect = over_surf.get_rect(
          center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 30)
      )

      restart_surf = font.render(
          "Press SPACE to Restart", True, WHITE
      )
      restart_rect = restart_surf.get_rect(
          center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 30)
      )

      final_score = font.render(
          f"Final Score: {score // 5}", True, GREEN
      )
      score_rect = final_score.get_rect(
          center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 80)
      )

      screen.blit(over_surf, over_rect)
      screen.blit(restart_surf, restart_rect)
      screen.blit(final_score, score_rect)

    pygame.display.flip()
    clock.tick(FPS)


if __name__ == "__main__":
  main()